# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# MongoDB Atlas (production) or a local mongod (development)
# Atlas example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=snapsync_prod

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=snapsync_events
CLOUDINARY_SELFIE_FOLDER=snapsync_selfies

# Pinecone (index must be 512 dimensions, cosine metric for ArcFace)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=snapsync

# Python face service (Hugging Face Space in production)
PYTHON_API_URL=http://127.0.0.1:7860
PYTHON_API_KEY=
PYTHON_API_TIMEOUT_MS=50000

# Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_COOKIE_NAME=snapsync_session
SESSION_DAYS=7
GUEST_SESSION_HOURS=12

# Public URL used in QR codes / share links (no trailing slash)
# Leave blank locally; set to https://your-domain.vercel.app in production.
PUBLIC_BASE_URL=

# Matching
MATCH_THRESHOLD=0.55
MATCH_TOP_K=60

# Watermark + image delivery
# Originals are stored as Cloudinary "authenticated" assets. PREVIEW_WIDTH is
# used to bake the public watermarked preview at upload time.
WATERMARK_TEXT=Natural Studio
PREVIEW_WIDTH=1600
# DOWNLOAD_WIDTH only applies to legacy photos that have no baked preview yet.
DOWNLOAD_WIDTH=2400

# Upload limits
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=10485760
MAX_SELFIE_BYTES=8388608
